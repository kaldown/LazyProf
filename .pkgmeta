package-as: LazyProf
license-output: LICENSE

externals:
  Libs/LibDataBroker-1.1: https://github.com/kaldown/LibDataBroker-1.1
  Libs/LibDBIcon-1.0: https://github.com/kaldown/LibDBIcon-1.0

ignore:
  - .git
  - .github
  - docs
  - scripts
  - releases
  - exchange
  - Makefile
  - "*.md"
  - Libs/Ace3/tests
  - Libs/CraftLib/Data/Sources
  - Libs/CraftLib/scripts
  - Libs/CraftLib/vendor
  - Libs/CraftLib/docs
  - Libs/CraftLib/Makefile

enable-nolib-creation: no
